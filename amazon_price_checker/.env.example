# Twilio credentials (required)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15550000000
TWILIO_TO_NUMBER=+15551111111

# Anomaly detection thresholds (optional — these are the defaults)
# Flag if current price is below this fraction of list price (0.30 = flag when >70% off)
THRESHOLD_MISPRICE_PCT=0.30
# Flag if current price is below this fraction of the "was" price (0.40 = flag when >60% off)
THRESHOLD_HISTORY_PCT=0.40
# Flag if seller price spread exceeds this fraction of the lowest price (0.50 = 50% spread)
THRESHOLD_SELLER_SPREAD=0.50

# Request timing in seconds (optional)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
